# Скопируйте в deploy/.env и смените пароли перед запуском на VPS:
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env

POSTGRES_USER=dratbo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=satisfactory

JWT_SECRET=change-me-long-random-jwt-secret

# Порт UI снаружи (если 8080 занят — укажите другой, например 8088)
GATEWAY_PORT=8080

# Метрики только с localhost VPS (SSH-туннель)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Cloudflare Tunnel (HTTPS) — токен из Zero Trust → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
